+// Local patch (CMPE 249, JetPack 6.2): on L4T R36.4.3 the default cudaMallocAsync pool tops out at about
+// 2.5 GB per process (measured), so the 811 MB visual engine cannot be deserialized after the INT8 LLM
+// engine. With EDGELLM_SYNC_GPU_ALLOCATOR=1, engines loaded here use plain cudaMalloc/cudaFree instead.
+namespace
+{
+class SyncGpuAllocator : public nvinfer1::IGpuAsyncAllocator
+{
+public:
+    void* allocateAsync(uint64_t const size, uint64_t const alignment, nvinfer1::AllocatorFlags const /*flags*/,
+        cudaStream_t /*stream*/) noexcept override
+    {
+        uint64_t const align = alignment > 256 ? alignment : 256; // cudaMalloc itself is 256-byte aligned
+        if ((align & (align - 1)) != 0)
+        {
+            return nullptr;
+        }
+        uint64_t const extra = align > 256 ? align : 0;
+        void* base{nullptr};
+        if (cudaMalloc(&base, size + extra) != cudaSuccess)
+        {
+            return nullptr;
+        }
+        auto const aligned = (reinterpret_cast<uintptr_t>(base) + (align - 1)) & ~static_cast<uintptr_t>(align - 1);
+        void* ptr = reinterpret_cast<void*>(aligned);
+        std::lock_guard<std::mutex> lock(mMutex);
+        mBase[ptr] = base;
+        return ptr;
+    }
+    bool deallocateAsync(void* const memory, cudaStream_t /*stream*/) noexcept override
+    {
+        void* base = memory;
+        {
+            std::lock_guard<std::mutex> lock(mMutex);
+            auto it = mBase.find(memory);
+            if (it != mBase.end())
+            {
+                base = it->second;
+                mBase.erase(it);
+            }
+        }
+        return cudaFree(base) == cudaSuccess;
+    }
+
+private:
+    std::mutex mMutex;
+    std::unordered_map<void*, void*> mBase;
+};
+} // namespace
